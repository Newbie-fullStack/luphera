    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
