APP_NAME=Luphéra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Storefront and admin origins (CORS + Sanctum stateful domains)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Local dev may use sqlite (default Laravel); Docker and production use MySQL 8.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=luphera
DB_USERNAME=luphera
DB_PASSWORD=secret

# --- Sessions and cache -----------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false

CACHE_STORE=redis

# --- Redis ------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# --- Queues -----------------------------------------------------------------
QUEUE_CONNECTION=redis
HORIZON_PREFIX=luphera_horizon:

# --- Search -----------------------------------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=masterKey

# --- Files (S3-compatible, MinIO in local) ----------------------------------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=luphera
AWS_SECRET_ACCESS_KEY=luphera-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=luphera
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_URL=http://127.0.0.1:9000/luphera

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="bonjour@luphera.ma"
MAIL_FROM_NAME="${APP_NAME}"

# --- Brand (placeholders until the client provides the real details) --------
LUPHERA_WHATSAPP="[à compléter]"
LUPHERA_EMAIL="[à compléter]"

# --- Media ------------------------------------------------------------------
LUPHERA_MEDIA_DISK=s3
LUPHERA_MEDIA_MAX_UPLOAD_KB=5120

# --- AI (phase 6) -----------------------------------------------------------
LUPHERA_AI_ENABLED=false
LUPHERA_AI_DAILY_TOKENS=200000
ANTHROPIC_API_KEY=

# --- Public forms -----------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability (phase 7) ------------------------------------------------
SENTRY_LARAVEL_DSN=

BROADCAST_CONNECTION=log
