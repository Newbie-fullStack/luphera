# Admin SPA (Vite). The API is proxied in development, so the browser stays
# on http://localhost:5174 and Sanctum sees a stateful request.
VITE_API_PROXY=http://localhost:8000
# Absolute API URL when the admin app is served from another host in production.
# VITE_API_URL=https://api.luphera.ma/api/v1
